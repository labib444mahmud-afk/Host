# Local development only. On Railway, add these under Service -> Variables.
BOT_TOKEN=YOUR_BOTFATHER_TOKEN
OWNER_USER_ID=YOUR_NUMERIC_TELEGRAM_USER_ID
CHANNEL_ID=@YourChannel
OWNER_CONTACT=@YourOwnerUsername

# Persistent storage path. Railway Volume should be mounted at /data.
DATA_ROOT=/data

# Hosting defaults
DEFAULT_USER_LIMIT=2
MAX_CONFIGURABLE_LIMIT=100
MAX_UPLOAD_MB=50
MAX_ZIP_EXTRACT_MB=200
MAX_ZIP_FILES=1000
